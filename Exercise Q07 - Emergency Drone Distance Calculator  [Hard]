/******************************************************************************
Exercise Q07 - Emergency Drone Distance Calculator  [Hard]

Input: 
x1
y1
x2
y2

Process: 
dx = x2 - x1
dy = y2 - y1
Distance = sqrt(pow(dx,2) + pow(dy,2))
RoundedDistance = round(Distance)

Output:
dx
dy
Distance
Rounded Distance
*******************************************************************************/
#include <iostream>
#include <cmath>
#include <iomanip>
using namespace std;

int main()
{
    double x1, y1, x2, y2, dx, dy, Distance;
    int RoundedDistance;
    
    //Input
    cout << "Enter starting point x1: ";
    cin >> x1;
    
    cout << "Enter starting point y1: ";
    cin >> y1;
    
    cout << "Enter target point x2: ";
    cin >> x2;
    
    cout << "Enter target point y2: ";
    cin >> y2;
    
    //Process
    dx = x2 - x1;
    dy = y2 - y1;
    Distance = sqrt(pow(dx,2) + pow(dy,2));
    RoundedDistance = round(Distance);

    //Output
    cout << fixed << setprecision(3); 
    cout << "\ndx: " << dx;
    cout << "\ndy: " << dy;
    cout << "\nDistance: " << Distance;
    cout << "\nRounded distance: " << RoundedDistance;
    
    return 0;
}
